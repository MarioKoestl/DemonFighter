# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/TestResults/

# Never ignore Assets/Packages or ProjectSettings
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**
!/[Pp]roject[Ss]ettings/**

# IDE and generated solution files (Unity regenerates them)
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Crash reports
sysinfo.txt
*.stackdump

# Builds
*.apk
*.unitypackage
*.app

# Art source files stay local for now (see docs/DECISIONS.md D-021)
/ArtSource/

# Claude Code local settings
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store
